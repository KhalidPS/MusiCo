# Copy this file to `keystore.properties` (same directory) and fill in your real values.
#
# `keystore.properties` and the keystore file itself are gitignored on purpose - the upload
# key and its passwords must never be committed. If you lose the keystore you can no longer
# publish updates to the same Play listing, so back it up somewhere safe and permanent.
#
# Create the keystore with (choose your own passwords when prompted):
#
#   keytool -genkeypair -v \
#     -keystore musico-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias musico-upload
#
# Run it from the repo root, then set storeFile below to the path it produced
# (relative to the repo root).

storeFile=musico-upload.jks
storePassword=
keyAlias=musico-upload
keyPassword=
